# Optional provider paths. Use absolute executable paths; do not commit secrets.
# STEVIE_CODEX_BIN=C:\\Users\\you\\AppData\\Local\\OpenAI\\Codex\\bin\\codex.exe
# STEVIE_CLAUDE_BIN=C:\\path\\to\\claude.exe

# Personal contact fields stay in local environment settings and are not stored
# in the public repository. They are used when drafting application documents.
# STEVIE_PROFILE_NAME=Your name
# STEVIE_CONTACT_EMAIL=you@example.com
# STEVIE_LINKEDIN=https://www.linkedin.com/in/your-profile
# STEVIE_UK_PHONE=+44 ...
# STEVIE_OTHER_PHONE=+353 ...

# Optional private seed with profile, evidence, historical jobs, writing instructions
# and document validation rules. The default data/private-seed.json is ignored by Git.
# A fresh checkout without this file starts with an empty candidate profile.
# Only a new database imports seed records; existing databases are left intact.
# STEVIE_PRIVATE_SEED=C:\\path\\to\\private-seed.json

# Optional model overrides used only by the selected native client.
# STEVIE_CODEX_MODEL=
# STEVIE_CLAUDE_MODEL=

# Required for remote HTTPS deployment. Local loopback mode needs neither.
# STEVIE_PASSWORD=use-a-long-random-password
# STEVIE_PUBLIC_URL=https://jobs.example.com

# Optional, separately billed API providers.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Push keys are generated once in private data/push-keys.json. Keep it persistent.
# Optional push-service contact:
# STEVIE_PUSH_CONTACT=mailto:you@example.com
